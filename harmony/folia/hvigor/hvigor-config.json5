{
  // Hvigor 构建配置（Stage 模型 / API 12+ 工程的标准文件）。
  // ⚠️ 版本号需与本机 DevEco Studio 版本匹配：用 DevEco 新建任意 Empty Ability 工程，
  //    复制其生成的 hvigor/hvigor-config.json5 覆盖本文件即可；版本不符时 Sync 会报错。
  //    这里给出 NEXT / API 12 模板的常见固定版本作为起点。
  "modelVersion": "5.0.0",
  "hvigorVersion": "4.0.2",
  "dependencies": {
    "@ohos/hvigor-ohos-plugin": "5.0.5"
  },
  "execution": {
    // 构建内存，较复杂的工程可调大
    "maxHeapSize": "4096m"
  },
  "logging": {
    "level": "info"
  },
  "debugging": {
    "stacktrace": false
  },
  "nodeOptions": {}
}
