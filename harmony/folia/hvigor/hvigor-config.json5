{
  // Hvigor 构建配置（Stage 模型）。
  // Command Line Tools 26.0.1 起采用 all-in-one 安装模式：hvigor 插件已内置，
  // dependencies 必须留空对象 —— 若写入 @ohos/hvigor-ohos-plugin 等，hvigor 会试图
  // 从 npm 拉这个私有包而失败（它只在华为 ohpm 仓库，npm 镜像上没有）。
  // 见 hvigor 错误码 00308003 的说明。
  "modelVersion": "6.0.0",
  "dependencies": {},
  "execution": {
    "daemon": false
  },
  "logging": {
    "level": "info"
  },
  "debugging": {
    "stacktrace": false
  },
  "nodeOptions": {}
}
